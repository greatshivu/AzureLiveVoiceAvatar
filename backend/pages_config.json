[
  {
    "key": "orders",
    "prefix": "order",
    "title": "Order Search",
    "subtitle": "Search and filter across 1,000 customer orders.",
    "route": "/orders",
    "navIcon": "cart",
    "noun": "orders",
    "collection": "orders",
    "endpoint": "/orders/search",
    "aliases": [
      "order",
      "orders",
      "order search",
      "sales",
      "purchase",
      "purchases"
    ],
    "searchPlaceholder": "Search by order number or customer\u2026",
    "hints": [
      "Show delivered orders",
      "High priority paid orders",
      "Get medium priority order",
      "Read the top order",
      "Next page"
    ],
    "controls": [
      {
        "id": "q",
        "type": "text",
        "param": "q",
        "label": "Keyword",
        "idPrefix": "ORD-",
        "idRegex": "ord[-\\s]?(\\d{3,})|order(?:\\s+number)?[\\s#]+(\\d{3,})",
        "searchFields": [
          "order_number",
          "customer_name"
        ],
        "prefixWords": [
          "keyword",
          "order",
          "customer",
          "number"
        ]
      },
      {
        "id": "status",
        "type": "select",
        "param": "status",
        "label": "Status",
        "options": [
          {
            "value": "Pending"
          },
          {
            "value": "Processing"
          },
          {
            "value": "Shipped"
          },
          {
            "value": "Delivered"
          },
          {
            "value": "Cancelled",
            "synonyms": [
              "cancelled",
              "canceled"
            ]
          }
        ]
      },
      {
        "id": "range",
        "type": "daterange",
        "paramFrom": "date_from",
        "paramTo": "date_to",
        "label": "Date Range",
        "field": "order_date"
      },
      {
        "id": "priority",
        "type": "radio",
        "param": "priority",
        "label": "Priority",
        "options": [
          {
            "value": "Low",
            "synonyms": [
              "low",
              "low priority",
              "lowest"
            ]
          },
          {
            "value": "Medium",
            "synonyms": [
              "medium",
              "medium priority",
              "normal priority",
              "mid"
            ]
          },
          {
            "value": "High",
            "synonyms": [
              "high",
              "high priority",
              "urgent",
              "highest"
            ]
          }
        ]
      },
      {
        "id": "paid_only",
        "type": "checkbox",
        "param": "paid_only",
        "label": "Paid orders only",
        "shortLabel": "paid",
        "field": "is_paid",
        "onWords": [
          "paid"
        ],
        "offWords": [
          "unpaid"
        ]
      }
    ],
    "columns": [
      {
        "key": "order_number",
        "label": "Order #",
        "type": "bold"
      },
      {
        "key": "customer_name",
        "label": "Customer"
      },
      {
        "key": "status",
        "label": "Status",
        "type": "badge"
      },
      {
        "key": "priority",
        "label": "Priority",
        "type": "badge"
      },
      {
        "key": "region",
        "label": "Region"
      },
      {
        "key": "is_paid",
        "label": "Paid",
        "type": "boolean"
      },
      {
        "key": "amount",
        "label": "Amount",
        "align": "right",
        "type": "currency"
      },
      {
        "key": "order_date",
        "label": "Date",
        "align": "right",
        "type": "date"
      }
    ],
    "speak_template": "Order {order_number} for {customer_name}. Status {status}, {priority} priority, {paid_label}. Amount {amount} dollars, region {region}."
  },
  {
    "key": "items",
    "prefix": "item",
    "title": "Items Search",
    "subtitle": "Browse and filter the full catalog of 1,000 items.",
    "route": "/items",
    "navIcon": "package",
    "noun": "items",
    "collection": "items",
    "endpoint": "/items/search",
    "aliases": [
      "item",
      "items",
      "items search",
      "product",
      "products",
      "catalog",
      "inventory"
    ],
    "searchPlaceholder": "Search by item name or SKU\u2026",
    "hints": [
      "Electronics in stock",
      "Refurbished items",
      "Read the top item",
      "Reset filters"
    ],
    "controls": [
      {
        "id": "q",
        "type": "text",
        "param": "q",
        "label": "Keyword",
        "idPrefix": "SKU-",
        "idRegex": "sku[-\\s]?(\\d{3,})|item(?:\\s+number)?[\\s#]+(\\d{3,})",
        "searchFields": [
          "name",
          "sku"
        ],
        "prefixWords": [
          "keyword",
          "sku",
          "item",
          "product",
          "name"
        ]
      },
      {
        "id": "category",
        "type": "select",
        "param": "category",
        "label": "Category",
        "options": [
          {
            "value": "Electronics",
            "synonyms": [
              "electronic",
              "electronics",
              "gadget",
              "gadgets",
              "device",
              "devices",
              "laptop",
              "laptops",
              "computer",
              "phone"
            ]
          },
          {
            "value": "Apparel",
            "synonyms": [
              "clothing",
              "clothes",
              "wear",
              "shirt"
            ]
          },
          {
            "value": "Home & Garden",
            "synonyms": [
              "home",
              "garden",
              "kitchen",
              "furniture"
            ]
          },
          {
            "value": "Sports",
            "synonyms": [
              "sport",
              "sports",
              "fitness",
              "gym"
            ]
          },
          {
            "value": "Books",
            "synonyms": [
              "book",
              "books",
              "novel",
              "reading"
            ]
          }
        ]
      },
      {
        "id": "range",
        "type": "daterange",
        "paramFrom": "date_from",
        "paramTo": "date_to",
        "label": "Date Range",
        "field": "added_date"
      },
      {
        "id": "condition",
        "type": "radio",
        "param": "condition",
        "label": "Condition",
        "options": [
          {
            "value": "New",
            "synonyms": [
              "new",
              "brand new"
            ]
          },
          {
            "value": "Used",
            "synonyms": [
              "used",
              "second hand",
              "pre-owned"
            ]
          },
          {
            "value": "Refurbished",
            "synonyms": [
              "refurb",
              "refurbished"
            ]
          }
        ]
      },
      {
        "id": "in_stock_only",
        "type": "checkbox",
        "param": "in_stock_only",
        "label": "In stock only",
        "shortLabel": "in-stock",
        "field": "in_stock",
        "onWords": [
          "in stock",
          "in-stock",
          "available",
          "stocked"
        ],
        "offWords": [
          "out of stock"
        ]
      }
    ],
    "columns": [
      {
        "key": "sku",
        "label": "SKU",
        "type": "bold"
      },
      {
        "key": "name",
        "label": "Item Name"
      },
      {
        "key": "category",
        "label": "Category"
      },
      {
        "key": "condition",
        "label": "Condition",
        "type": "badge"
      },
      {
        "key": "supplier",
        "label": "Supplier"
      },
      {
        "key": "stock",
        "label": "Stock",
        "type": "stock"
      },
      {
        "key": "price",
        "label": "Price",
        "align": "right",
        "type": "currency"
      },
      {
        "key": "added_date",
        "label": "Added",
        "align": "right",
        "type": "date"
      }
    ],
    "speak_template": "{name}, SKU {sku}. Category {category}, condition {condition}. {stock_label}, priced at {price} dollars, supplied by {supplier}."
  }
]